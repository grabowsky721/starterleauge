# ============================================
# PINDOLZ Discord Bot – przykładowy plik środowiska
# Skopiuj jako `.env` albo ustaw te same nazwy
# w panelu GameHost (Variables / Environment).
# NIE commituj prawdziwego `.env` z tokenami.
# ============================================

# --- Wymagane ----------------------------------------

# Token bota Discord
# https://discord.com/developers/applications → Bot → Reset Token / Copy
DISCORD_BOT_TOKEN=

# Token StarterLeague Partner API (zaczyna się od slp_)
# https://starterleague.pl → po akceptacji regulaminu Partner API
STARTERLEAGUE_API_TOKEN=

# --- Opcjonalne: grafiki meczowe (Cloudflare Workers AI) ---
# Bez tych dwóch bot działa normalnie, tylko bez obrazków AI.
# Panel: https://dash.cloudflare.com/?to=/:account/ai/workers-ai
# Account ID jest też w URL: dash.cloudflare.com/<ACCOUNT_ID>/...

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# --- Koniec -------------------------------------------
# GameHost: Bot py file = src/bot.py
#           Requirements  = requirements.txt
#           Auto Update   = 1
# Drużyna w kodzie: PINDOLZ team id 869
